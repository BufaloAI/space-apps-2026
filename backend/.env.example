# Bu dosyayı backend/.env olarak kopyalayıp doldurun. backend/.env git'e girmez.

# GPU sunucusundaki vLLM (Tailscale adresi) ve API key
VLLM_BASE_URL=http://100.96.165.43:8000/v1
VLLM_API_KEY=buraya-api-key
VLLM_MODEL=Qwen/Qwen3-8B-FP8

# Tek kullanıcılı oturum: aktif kullanıcı bu kadar saniye boşta kalırsa slot boşalır (5 dk)
IDLE_TIMEOUT_SECONDS=300
# Sıradaki kullanıcı bu kadar saniye hiç görünmezse sıradan düşer
QUEUE_TTL_SECONDS=30

# Model ayarları
MAX_TOKENS=800
TEMPERATURE=0.4
HISTORY_MAX_MESSAGES=20

# Frontend adresleri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Parsel poligonu: en fazla bu kadar hektar kabul edilir
MAX_AREA_HA=5000
# Bot ayar dosyası (varsayılan: backend/agents.toml)
# AGENTS_FILE=
# ML sağlayıcısı: fake (sahte, test) | xgboost (gerçek: repo kökündeki ml/ paketi)
ML_PROVIDER=fake
# Sahte ML sağlayıcısının yapay bekleme süresi (saniye)
ML_FAKE_DELAY_SECONDS=2
# Gerçek ML: model klasörü (boşsa ml/runs/LATEST), parsel veri önbelleği (boşsa ml/cache/parcels)
# ML_MODEL_DIR=
# ML_CACHE_DIR=
# NASA ORNL MODIS servisi yavaş/kararsız: istek başına zaman aşımı ve tekrar deneme
ML_NDVI_TIMEOUT_SECONDS=60
ML_NDVI_RETRIES=3
